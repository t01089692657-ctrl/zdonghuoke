# ============================================================================
# ZDHK 自动获客系统 — 环境变量样例
# 复制为 .env：  cp .env.example .env
#
# 关键开关：ADAPTER_MODE 决定使用「本地假适配器」还是「云端真实适配器」。
#   local  → 全部外部依赖用确定性 fake 实现，零外部 API、零费用，Mac mini 直接跑
#   cloud  → 切换到真实的大模型 / 海关数据 / 邮件发送适配器（需填下方密钥）
# 换模式不用改一行业务代码 —— 这是本项目「上云不重写」的核心。
# ============================================================================

APP_ENV=local                 # local | staging | production
ADAPTER_MODE=local            # local | cloud
LOG_LEVEL=INFO
LOG_JSON=false                # 生产设 true 输出结构化 JSON 日志

# ---- 数据库 ----------------------------------------------------------------
# 默认走 docker-compose 里的 Postgres。若想零 Docker 本地跑，改用 SQLite：
#   DATABASE_URL=sqlite+aiosqlite:///./local.db
DATABASE_URL=postgresql+asyncpg://zdhk:zdhk@localhost:5432/zdhk

# ---- Redis（队列/缓存，可选，local 模式可不启用）--------------------------
REDIS_URL=redis://localhost:6379/0

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ============================================================================
# 供应商选择（cloud 模式下，每样都能选「付费 API」或「免费/自建」变体）
#   想零成本先跑：LLM 用 Ollama(本地)、搜索用 searxng、富化用 website、验证用 local
#   详见 docs/06 第 7 节「$0 全免费栈」
# ============================================================================
# 旗舰(最全)： SEARCH=apollo  ENRICH=apollo+hunter+website  VERIFY=zerobounce  SENDER=ses
# 全免费：     SEARCH=searxng ENRICH=website               VERIFY=local       + Ollama 本地模型
SEARCH_PROVIDER=serper         # apollo(最全2.7亿库) | serper(付费Google) | searxng(自建免费)
ENRICH_PROVIDER=hunter         # apollo(最全) | hunter(付费) | website(免费抓官网) | apollo+hunter+website(全瀑布)
VERIFY_PROVIDER=zerobounce     # zerobounce(付费高准) | local(免费 语法+MX+一次性域名)
SENDER_PROVIDER=ses            # ses(推荐) | smtp(通用/免费档，仅测试用)

# ---- 大模型（cloud 模式）：OpenAI 兼容协议 -------------------------------
# 旗舰： OpenRouter https://openrouter.ai/api/v1  一个key通吃GPT/Claude/DeepSeek/Qwen
#        模型名如 openai/gpt-4o、anthropic/claude-3.5-sonnet、deepseek/deepseek-chat
# 便宜： DeepSeek   https://api.deepseek.com/v1
# 免费本地：Ollama   http://localhost:11434/v1  （Mac mini 本机跑，零 token 费）
#        本地时 LLM_API_KEY 随便填(如 ollama)，模型名用你 ollama pull 的，如 qwen2.5:7b
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_WRITER=deepseek-chat        # 写信/背调主力（旗舰例：openai/gpt-4o）
LLM_MODEL_CLASSIFIER=deepseek-chat    # 回复分类（量大用小杯省钱）

# ---- 数据源 / 富化（cloud 模式）------------------------------------------
APOLLO_API_KEY=               # Apollo.io 找客户+挖邮箱一体（旗舰，最全面）
SERP_API_KEY=                 # 搜索引擎源（Serper.dev）
SEARXNG_URL=http://localhost:8888   # 自建 SearXNG 地址（SEARCH_PROVIDER=searxng 时用）
CUSTOMS_API_KEY=              # 海关数据（ImportGenius/腾道，待接入）
MAPS_API_KEY=                 # 地图源（Outscraper/Apify，待接入）
HUNTER_API_KEY=               # enrichment（ENRICH_PROVIDER=hunter 时用）
SNOV_API_KEY=
EMAIL_VERIFY_API_KEY=         # ZeroBounce（VERIFY_PROVIDER=zerobounce 时用）

# ---- 邮件发送（cloud 模式，Amazon SES —— 推荐）----------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=zdhk-outbound

# ---- 通用 SMTP 发送（SENDER_PROVIDER=smtp 时用，可填 Brevo/Mailtrap 免费档）--
# ⚠️ 免费 SMTP 仅供测试；规模化冷邮件必须用 SES，见 docs/06 §2
SMTP_HOST=                    # 如 smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---- 安全 ----
SECRET_KEY=dev-only-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
