# ============================================================================
# ZDHK 自动获客系统 — 环境变量样例
# 复制为 .env：  cp .env.example .env
#
# 关键开关：ADAPTER_MODE 决定使用「本地假适配器」还是「云端真实适配器」。
#   local  → 全部外部依赖用确定性 fake 实现，零外部 API、零费用，Mac mini 直接跑
#   cloud  → 切换到真实的大模型 / 海关数据 / 邮件发送适配器（需填下方密钥）
# 换模式不用改一行业务代码 —— 这是本项目「上云不重写」的核心。
# ============================================================================

APP_ENV=local                 # local | staging | production
ADAPTER_MODE=local            # local | cloud
LOG_LEVEL=INFO
LOG_JSON=false                # 生产设 true 输出结构化 JSON 日志

# ---- 数据库 ----------------------------------------------------------------
# 默认走 docker-compose 里的 Postgres。若想零 Docker 本地跑，改用 SQLite：
#   DATABASE_URL=sqlite+aiosqlite:///./local.db
DATABASE_URL=postgresql+asyncpg://zdhk:zdhk@localhost:5432/zdhk

# ---- Redis（队列/缓存，可选，local 模式可不启用）--------------------------
REDIS_URL=redis://localhost:6379/0

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ---- 大模型（cloud 模式）：OpenAI 兼容协议，可指向 DeepSeek / Qwen ---------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_WRITER=deepseek-chat        # 写信/背调主力
LLM_MODEL_CLASSIFIER=deepseek-chat    # 回复分类（量大可换小杯）

# ---- 数据源（cloud 模式）--------------------------------------------------
SERP_API_KEY=                 # 搜索引擎源（Serper/SerpAPI）
CUSTOMS_API_KEY=              # 海关数据（ImportGenius/腾道）
MAPS_API_KEY=                 # 地图源（Outscraper/Apify）
HUNTER_API_KEY=               # enrichment
SNOV_API_KEY=
EMAIL_VERIFY_API_KEY=         # ZeroBounce/NeverBounce

# ---- 邮件发送（cloud 模式，Amazon SES）------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=zdhk-outbound

# ---- 安全 ----
SECRET_KEY=dev-only-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
